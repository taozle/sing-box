{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "type": "socks",
      "listen": "127.0.0.1",
      "listen_port": 1080
    },
    {
      "tag": "http-in",
      "type": "http",
      "listen": "127.0.0.1",
      "listen_port": 8080
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "block",
      "type": "block"
    }
  ],
  "experimental": {
    "prometheus": {
      "enabled": true,
      "listen": "127.0.0.1:9090",
      "inbounds": ["socks-in", "http-in"],
      "outbounds": ["direct", "block"]
    }
  }
}
